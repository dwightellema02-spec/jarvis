# JARVIS Core Environment Configuration
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Service Authentication (Phase 0 Foundation)
JARVIS_API_KEY=your-secure-internal-api-key-here

# AI Provider Configuration (Phase 1+ Foundation)
# Keys are strictly server-side and never exposed to clients
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Storage & Persistence
DATABASE_URL=file:./data/jarvis.db

# Security & Guardian
ENABLE_AUDIT_LOGS=true
STRICT_DEFAULT_DENY=true
